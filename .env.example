# Copy to .env and fill in. A key left blank (KEY=) counts as unset everywhere.

# Required
DANGER_DONTSHARETOYKEN=your_discord_bot_token

# Chatbot providers (all optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_HOST=

# Storage tiers (all optional; local SQLite is always the last fallback)
MONGODB_URI=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Monitoring (optional)
KUMA_PUSH_URL=
PUSHGATEWAY_URL=

# Dashboard HTTP API. The API stays off until BOT_API_KEY is set.
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=
# Preferred port (binds 0.0.0.0). Defaults to 8080. If it is busy the next free
# port is used; the port in use is written to database/api-port.
BOT_API_PORT=8080
